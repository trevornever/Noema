# Copy to .env. Keep secrets out of Git.
NOEMA_PORT=8000
NOEMA_CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Blank keys select Noema's built-in mock provider.
LLM_API_KEY=
LLM_BASE_URL=http://ollama:11434/v1
LLM_MODEL=llama3.2

# Optional image provider; blank uses the built-in mock adapter.
IMAGE_API_KEY=
IMAGE_API_URL=https://api.example-image-provider.com/v1/generate
IMAGE_AUTH_HEADER=Authorization
