POSTGRES_PASSWORD=noema-local-only
NOEMA_DATABASE_URL=postgresql://noema:noema-local-only@postgres:5432/noema

# Copy to .env. Never commit real credentials.
# Leave the LLM settings empty to use Noema's built-in mock provider.
# For local Ollama, enable the local-ai profile and uncomment these values:
# LLM_MOCK_MODE=false
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_MODEL=qwen2.5:7b
# LLM_API_KEY is not required for Ollama.

# Optional external OpenAI-compatible image provider. Leave blank for mock mode.
IMAGE_API_KEY=
IMAGE_API_URL=
IMAGE_AUTH_HEADER=Authorization

# Browser origins allowed to call this instance.
NOEMA_CORS_ORIGINS=http://localhost:8000
